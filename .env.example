# Copy this file to .env and fill in real values. .env itself is
# git-ignored and must never be committed - this file (.env.example) is
# safe to commit since it contains no real secrets.
#
# Where to get each value: see README.md > Environment variables.

ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Optional. Only used by the web process locally; most hosts (Voroa
# included) inject PORT automatically when deployed, so you don't need to
# set this yourself in production.
# PORT=5000
